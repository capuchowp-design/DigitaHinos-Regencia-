{
  "name": "regencia-ccb",
  "version": "1.0.0",
  "private": true,
  "description": "Partituras e regência animada dos hinos (PWA + APK via Capacitor)",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:assets": "capacitor-assets generate --android --assetPath assets",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
